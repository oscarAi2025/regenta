{
  "name": "regenta",
  "private": true,
  "description": "Regenta by Farmagenéricos Colombia — POS en la nube con facturación DIAN e inventario por lote para droguerías",
  "scripts": {
    "dev": "next dev -p 4500",
    "build": "next build",
    "start": "next start -p 4500",
    "typecheck": "tsc --noEmit",
    "db:reset": "node scripts/db-reset.mjs",
    "test": "node --test tests/db.test.mjs && node --experimental-strip-types --test tests/invima.test.mjs tests/pagos.test.mjs tests/matias.test.mjs",
    "e2e": "node tests/e2e/caja.mjs && node tests/e2e/gestion.mjs && node tests/e2e/ia.mjs && node tests/e2e/facturacion.mjs",
    "auditoria": "node tests/e2e/auditoria.mjs",
    "pagos": "node tests/e2e/pagos.mjs",
    "admin": "node tests/e2e/admin.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "jose": "^6.2.14",
    "next": "^15.5.28",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
